# Google AI Studio で発行する。課金アカウントの登録は不要（新規は自動で Free Tier）
GEMINI_API_KEY=

# Notion をレビュー面として使う場合に設定する。**両方揃ったときだけ有効になる**。
# 空のままでも全機能が動く（その場合は生成された Markdown の `## imo` に直接書く運用）。
# トークンの発行・インテグレーションの接続・DB ID の取り方は README の
# 「Notion をレビュー面として使う → 初期準備」を参照。
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 以下はすべて任意。既定値を上書きしたいときだけ設定する。
# 全一覧と既定値は README の「設定」節、実体は src/imotech/config.py を見ること。

# 使うソース。カンマ区切りで複数指定できる（例: hackernews,qiita）。
# 2 つ以上なら MultiFeed が束ねるので、呼び出し側のコードは変わらない
# IMOTECH_SOURCES=hackernews

# 熟成と選別
# IMOTECH_MATURATION_HOURS=24
# IMOTECH_MIN_SCORE=100
# IMOTECH_MIN_COMMENTS=30
# IMOTECH_MAX_DRAFTS_PER_RUN=5
# IMOTECH_MAX_AGE_HOURS=96

# 1 回の実行で HN に問い合わせる件数と時間の天井
# IMOTECH_MAX_PROBES_PER_RUN=60
# IMOTECH_PROBE_BUDGET=300

# Notion のレート制限（Free/Plus は 180 req/min）
# IMOTECH_NOTION_MIN_INTERVAL=0.35
# IMOTECH_NOTION_MAX_ATTEMPTS=3
# IMOTECH_NOTION_TIMEOUT=30

# ローカル検証で本番の候補ストアを汚さないための逃げ道
# IMOTECH_CANDIDATES_PATH=/tmp/try.jsonl
