---
/** SNS で共有されたときの画像。**作り方はここでは知らない**（記事の OG 画像は
 * `pages/og/[slug].png.ts` がビルド時に描く）。受け取った値をそのままタグにする。 */
interface OgImage {
  /** サイト内のパス（`/og/xxx.png`）。絶対 URL にはここで直す */
  src: string;
  width: number;
  height: number;
  /** 画像の説明。SNS 側で画像の代替テキストとして使われる */
  alt: string;
}
interface Props {
  title: string;
  description?: string;
  /** 記事ページは "article"、それ以外は "website"（https://ogp.me/#types ） */
  type?: "website" | "article";
  image?: OgImage;
}
const { title, description, type = "website", image } = Astro.props;
const site = "imoTech";
const pageTitle = title === site ? site : `${title} | ${site}`;
// og:url と og:image は**絶対 URL が要る**。site は astro.config.mjs の SITE_URL から来る
// （CI と公開では未設定だとビルドが落ちるので、localhost が焼き込まれることはない）
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(image.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />

    {/* Open Graph（https://ogp.me/ ）。これまで 1 つも無く、共有してもタイトルも画像も出なかった */}
    <meta property="og:site_name" content={site} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    {
      image && (
        <>
          <meta property="og:image" content={imageUrl} />
          {/* 寸法を書くと、クローラーが画像を落とさずに初回共有から描ける
              （https://developers.facebook.com/docs/sharing/webmasters/images ） */}
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }

    {/* X のカード。公式の仕様ページが消えていて og: へのフォールバックを一次情報で
        確かめられないので、**頼らずに明示的に出す**（値は og: と同じ） */}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {
      image && (
        <>
          <meta name="twitter:image" content={imageUrl} />
          <meta name="twitter:image:alt" content={image.alt} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
  </head>
  <body>
    <header>
      <a class="brand" href="/">{site}</a>
      <nav>
        <a href="/about">このサイトについて</a>
        <a href="/privacy">プライバシー</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>
        Hacker News や Qiita で話題になった技術記事を日本語でまとめています。要旨と論調の整理は生成 AI、imo は運営者が書いています。
        <a href="/about">制作プロセス</a>
      </p>
    </footer>
    <style is:global>
      /* デザインは後回しの方針。読める最低限だけ整える */
      :root {
        --fg: #1a1a1a;
        --muted: #666;
        --line: #e0e0e0;
        --accent: #0a5;
        --bg: #fff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #e8e8e8;
          --muted: #999;
          --line: #333;
          --accent: #4c9;
          --bg: #161616;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        color: var(--fg);
        background: var(--bg);
        font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif;
        line-height: 1.8;
      }
      header, main, footer { max-width: 44rem; margin: 0 auto; padding: 0 1rem; }
      header {
        display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: baseline;
        padding-top: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line);
      }
      .brand { font-weight: 700; font-size: 1.25rem; text-decoration: none; color: var(--fg); }
      nav { display: flex; gap: 1rem; font-size: 0.875rem; }
      a { color: var(--accent); }
      main { padding-top: 2rem; padding-bottom: 3rem; }
      footer {
        border-top: 1px solid var(--line); padding-top: 1.5rem; padding-bottom: 3rem;
        color: var(--muted); font-size: 0.8125rem;
      }
      h1 { font-size: 1.5rem; line-height: 1.5; }
      h2 { font-size: 1.125rem; margin-top: 2.5rem; border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; }
      h3 { font-size: 1rem; margin-top: 1.75rem; }
      .meta { color: var(--muted); font-size: 0.8125rem; }
      /* アイキャッチ。画面幅に合わせて縮め、縦横比は width/height 属性から保つ。
         カードは白地なので、暗い背景では枠線が無いと境目が見えない */
      .eyecatch { display: block; width: 100%; height: auto; margin: 0.5rem 0 1rem; border: 1px solid var(--line); border-radius: 6px; }
      .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; }
      .tags a { font-size: 0.75rem; text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: 0.125rem 0.625rem; }
      .entries { list-style: none; padding: 0; }
      .entries li { padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
      /* 記事本文の箇条書き。用語が 5 件並ぶと、余白が無いと塊になって読めない */
      article li { margin-bottom: 0.4rem; }
      article .entries li { margin-bottom: 0; }
      .entries h2 { border: 0; margin: 0 0 0.25rem; font-size: 1.0625rem; }
      .entries h2 a { text-decoration: none; }
      .disclosure { margin-top: 3rem; padding: 0.875rem 1rem; border-left: 3px solid var(--line); color: var(--muted); font-size: 0.8125rem; }
    </style>
  </body>
</html>
