---
import ArticleEntry from "../../components/ArticleEntry.astro";
import Base from "../../layouts/Base.astro";
import { allTags, publishedArticles } from "../../lib/articles";

export async function getStaticPaths() {
  const articles = await publishedArticles();
  return allTags(articles).map((tag) => ({
    params: { tag },
    props: { articles: articles.filter((a) => a.data.tags.includes(tag)), tag },
  }));
}

const { articles, tag } = Astro.props;
---

<Base title={`#${tag} の記事`}>
  <h1>#{tag}</h1>
  <p class="meta">{articles.length} 件</p>
  <ul class="entries">
    {articles.map((a, i) => <ArticleEntry article={a} eager={i === 0} />)}
  </ul>
  <p><a href="/">← 記事一覧へ</a></p>
</Base>
