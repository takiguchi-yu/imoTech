---
import ArticleEntry from "../components/ArticleEntry.astro";
import Base from "../layouts/Base.astro";
import { allTags, publishedArticles } from "../lib/articles";

const articles = await publishedArticles();
const tags = allTags(articles);
---

<Base
  title="imoTech"
  description="Hacker News や Qiita で話題になった技術記事を、元記事の要旨、議論の論調、使いどころ、そして運営者の imo とともに日本語で紹介します。"
>
  <p>
    Hacker News や Qiita で話題になった技術記事を、<strong>元記事の要旨</strong>・<strong
      >議論の論調</strong
    >・<strong>使いどころ</strong>・<strong>imo（運営者の所感）</strong>で紹介しています。
  </p>

  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((t) => (
          <li>
            <a href={`/tags/${t}/`}>#{t}</a>
          </li>
        ))}
      </ul>
    )
  }

  {
    articles.length === 0 ? (
      <p class="meta">まだ記事がありません。</p>
    ) : (
      <ul class="entries">
        {articles.map((a, i) => (
          <ArticleEntry article={a} eager={i === 0} />
        ))}
      </ul>
    )
  }
</Base>
